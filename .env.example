# -----------------------------------------------------------------------------
# B2B Lead-Generation Agent Configuration Template
# Copy this file to '.env' and fill in your values.
# -----------------------------------------------------------------------------

# Gemini API Key (Required for search grounding and LLM tasks)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Google Sheets Configuration (Optional - defaults to local CSV file if not provided)
# Target Google Spreadsheet ID (from its URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=
# Path to your Google Service Account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=

# LangSmith Tracing Configuration (Optional - set to visualize agent loops)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=b2b-lead-generation-agent
